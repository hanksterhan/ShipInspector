{
    "name": "server",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "build": "npm run build:wasm && npm run verify:wasm && tsc && tsc-alias -p tsconfig.json && tsc -p ../common/tsconfig.json && npm run copy-assets",
        "verify:wasm": "bash ../scripts/verify-wasm.sh || echo 'WASM verification skipped'",
        "lint": "prettier --write \"src/**/*.ts\"",
        "test": "jest",
        "copy-assets": "mkdir -p dist/lib/wasm-equity/pkg && cp -r ../lib/wasm-equity/pkg/* dist/lib/wasm-equity/pkg/ 2>/dev/null || true",
        "build:wasm": "cd ../lib/wasm-equity && bash build.sh || echo 'WASM build failed or skipped, continuing with existing package if available...'"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "jest": {
        "transform": {
            "^.+\\.(ts|tsx)$": "ts-jest"
        },
        "testEnvironment": "node",
        "moduleFileExtensions": [
            "ts",
            "tsx",
            "js",
            "json",
            "node"
        ],
        "testMatch": [
            "**/src/**/*.spec.(ts|tsx)"
        ],
        "moduleNameMapper": {
            "^@common/(.*)$": "<rootDir>/../common/src/$1"
        }
    },
    "dependencies": {
        "@neondatabase/serverless": "^1.0.2",
        "bcryptjs": "^3.0.3",
        "dotenv": "^16.4.5"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/jest": "^29.5.12",
        "@types/node": "^22.1.0",
        "copyfiles": "^2.4.1",
        "dotenv-cli": "^7.4.2",
        "jest": "^29.7.0",
        "prettier": "^3.3.3",
        "ts-jest": "^29.2.4",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "typescript": "^5.5.4"
    }
}
