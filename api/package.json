{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc && tsc-alias -p tsconfig.json && npm run copy-wasm",
    "copy-wasm": "mkdir -p dist/lib/wasm-equity/pkg && cp ../lib/wasm-equity/pkg/wasm_equity_bg.wasm ../lib/wasm-equity/pkg/wasm_equity.js ../lib/wasm-equity/pkg/wasm_equity.d.ts ../lib/wasm-equity/pkg/wasm_equity_bg.wasm.d.ts dist/lib/wasm-equity/pkg/",
    "test": "jest"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "@clerk/express": "^1.7.60",
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/node": "^3.0.0",
    "axios": "^1.3.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.1.0",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.5.4"
  },
  "jest": {
    "transform": { "^.+\\.ts$": "ts-jest" },
    "testEnvironment": "node",
    "moduleFileExtensions": ["ts", "js", "json", "node"],
    "testMatch": ["**/*.spec.ts"],
    "modulePathIgnorePatterns": ["<rootDir>/dist"],
    "testPathIgnorePatterns": ["/node_modules/", "/dist/"],
    "moduleNameMapper": {
      "^@common/(.*)$": "<rootDir>/../common/src/$1"
    }
  }
}

