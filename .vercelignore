# API spec/tests (not serverless functions)
api/**/*.spec.ts

# Development files
*.log
*.md
.git
.gitignore

# Server files that are not needed for build
server/node_modules/

# Keep server/src/config/ and server/src/services/ - needed by API handlers
# Keep lib/wasm-equity/ - needed for equity calculations
# Keep lib/wasm-equity/pkg/ - pre-built WASM (saves 2-3 min per build)

# Environment files (will be set in Vercel dashboard)
.env
.env.*
!.env.example

# Node modules (will be installed during build)
node_modules/

# Development tools (not needed for build)
web/plopfile.js
web/plop/

# Rust build artifacts (cached by Vercel if present, but not needed in deployment)
lib/wasm-equity/target/

# IMPORTANT: Source files and configs are NEEDED for build
# We explicitly include them by NOT excluding them
# - web/src/ (needed for Vite)
# - web/public/ (needed for Vite)
# - common/src/ (needed for TypeScript compilation)
# - lib/src/ (needed for shared utilities)
# - tsconfig.json files (needed for TypeScript)
# - package.json files (needed for npm install)
# - lib/wasm-equity/pkg/ (pre-built WASM - CRITICAL for fast builds)
