{
  "name": "ship-inspector-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 4000",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prestorybook": "node scripts/prepare-storybook.mjs",
    "storybook": "storybook dev --port 6006 --host 127.0.0.1 --no-open",
    "prebuild-storybook": "node scripts/prepare-storybook.mjs",
    "build-storybook": "storybook build --output-dir storybook-static",
    "preview-storybook": "vite preview --outDir storybook-static --port 6006 --host 127.0.0.1 --strictPort",
    "typecheck:storybook": "tsc --project tsconfig.storybook.json --noEmit",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:storybook:watch": "vitest --config vitest.storybook.config.ts",
    "check:storybook:source": "node scripts/source-inventory.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.60.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.563.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "10.3.1",
    "@storybook/addon-docs": "10.3.1",
    "@storybook/addon-vitest": "10.3.1",
    "@storybook/react-vite": "10.3.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jsdom": "^25.0.0",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.3",
    "prettier": "^3.4.0",
    "shadcn": "^3.8.4",
    "storybook": "10.3.1",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
